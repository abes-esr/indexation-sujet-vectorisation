# Base de données vectorielle Qdrant
INDEXATION_SUJET_QDRANT_HOST=localhost
INDEXATION_SUJET_QDRANT_PORT=6333
INDEXATION_SUJET_QDRANT_TEST_LIMIT=6
# Seuil minimal de vecteurs pour autoriser l'écrasement dans Qdrant (1000 en prod, baisser pour les petits CSV de test)
INDEXATION_SUJET_QDRANT_MIN_VECTORS=1000

# Web Service
INDEXATION_SUJET_VECTORISATION_HOST=0.0.0.0
INDEXATION_SUJET_VECTORISATION_PORT=6381

# Fichiers CSV d'entrée RAMEAU (situés dans /app/data/csv)
INDEXATION_SUJET_CSV_INIT_FILENAME=export_rameau.csv
INDEXATION_SUJET_CSV_UPDATE_FILENAME=export_rameau_update.csv

# Paramètres de vectorisation pour les routes /init et /update
INDEXATION_SUJET_VECTORIZE_CONCEPTS_OR_CHAINS=concepts,chains
INDEXATION_SUJET_VECTORIZE_LANGS=fr,all
INDEXATION_SUJET_VECTORIZE_AVEC_THESE=only_mono
INDEXATION_SUJET_VECTORIZE_MAX_PARALLEL=2
# Threads de calcul par sous-processus (vide ou 0 = CPU du conteneur / MAX_PARALLEL)
INDEXATION_SUJET_VECTORIZE_THREADS_PER_JOB=
